<div class="{{cssClass}} {{actor.type}} flexcol">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    {{> "systems/edgeliner-rpg/templates/actor/parts/actor-header.hbs"}}
  </header>

  {{!-- Sheet Tab Navigation --}}
  {{!-- Drop Down that doesn't align like I want when scrolling --}}
  <nav class="sheet-tabs tabs" style="padding: 10px;" data-group="frontpage">
    <a class="item" data-tab="abilities">Abilities</a>
    <a class="item" data-tab="skills">Skills</a>
    <a class="item" data-tab="equipment">Equipment</a>
    <a class="item" data-tab="psychic">Psychic Powers</a>
    <a class="item" data-tab="totem">Totem Aspects</a>
    <a class="item" data-tab="words">Words of Power</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Abilties Tab --}}
    <div class="tab abilities" data-group="frontpage" data-tab="abilities">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-abilities.hbs"}}
    </div>

    {{!-- Owned Skills Tab --}}
    <div class="tab skills" data-group="frontpage" data-tab="skills">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-skills.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="frontpage" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Equipement SUB-Tab --}}
    <div class="tab equipment" data-group="frontpage" data-tab="equipment">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-equipment.hbs"}}
    </div>

    {{!-- Owned Psychic Powers SUB-Tab --}}
    <div class="tab psychic" data-group="frontpage" data-tab="psychic">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-psychic.hbs"}}
    </div>

    {{!-- Owned Totem Aspects SUB-Tab --}}
    <div class="tab totem" data-group="frontpage" data-tab="totem">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-totem.hbs"}}
    </div>

    {{!-- Owned Words of Power SUB-Tab --}}
    <div class="tab words" data-group="frontpage" data-tab="words">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-words.hbs"}}
    </div>

    {{!-- Owned Powers Tab --}}
    {{!-- <div class="tab powers" data-group="frontpage" data-tab="powers">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-powers.hbs"}}
    </div> --}}

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="frontpage" data-tab="effects">
      {{> "systems/edgeliner-rpg/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</div>
