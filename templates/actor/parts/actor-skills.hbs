<section>
  <div class="skills-header">
    <h4>Charm Skills ({{system.abilities.charm.die}}+{{system.abilities.charm.bonus}})</h4>
    <div class="skills-columns">
      <div class="skills-column">
        {{#each (firstHalf system.skillsCharm) as |skill key|}}
          <div>
            <div class="fa fa-plus-square increase-skill" data-category="skillsCharm" data-skill="{{key}}"></div>
            {{skill.value}}
            <div class="fa fa-minus-square decrease-skill" data-category="skillsCharm" data-skill="{{key}}"></div>
            &nbsp;
            <a class="rollable" data-roll="{{skill.value}}+@charm.die+@charm.bonus" data-label="{{localize (lookup @root.config.skillsCharm key)}}">{{localize (lookup @root.config.skillsCharm key)}}</a>
          </div>
        {{/each}}
      </div>
      <div class="skills-column">
        {{#each (secondHalf system.skillsCharm) as |skill key|}}
          <div>
            <div class="fa fa-plus-square increase-skill" data-category="skillsCharm" data-skill="{{key}}"></div>
            {{skill.value}}
            <div class="fa fa-minus-square decrease-skill" data-category="skillsCharm" data-skill="{{key}}"></div>
