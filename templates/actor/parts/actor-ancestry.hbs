<div class='items-list'>
  {{#if ancestry}}
    <div class='item flexrow' data-item-id='{{ancestry._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='item'>
            <img
              src='{{ancestry.img}}'
              title='{{ancestry.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <h4>{{ancestry.name}}</h4>
      </div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Edit" type="ancestry"}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type="ancestry"}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </div>
  {{else}}
    <div class='item flexrow'>
      <div class='item-name'>Drag an Ancestry item here</div>
    </div>
  {{/if}}
</div>
