<h4>Weapons</h4>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "Name"}}</div>
    <div class="item-stamina">{{localize "Stamina"}}</div>
    <div class="item-damagetype">{{localize "Type"}}</div>
    <div class="item-range">{{localize "Range"}}</div>
    <div class="item-capacity">{{localize "Capacity"}}</div>
    <div class="item-rateoffire">{{localize "ROF"}}</div>
    <div class="item-hands">{{localize "Hands"}}</div>
    <div class="item-formula">{{localize "Damage"}}</div>
    <div class="item-controls">
    </div>
  </li>
  {{#each items as |item id|}}
    {{#if (eq item.type 'weapon')}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <a class="rollable" data-roll-type="item">
            <img
              src="{{item.img}}"
              title="{{item.name}}"
              width="24"
              height="24"
            />
          </a>
        </div>
        <label>{{item.name}}</label>
      </div>
      <div class="item-stamina item-prop">{{item.system.weapon.stamina}}</div>
      <div class="item-damagetype item-prop">{{localize (lookup @root.config.weaponDamageTypes item.system.weapon.damageType)}}</div>
      <div class="item-range item-prop">{{localize (lookup @root.config.weaponRanges item.system.weapon.range)}}</div>
      <div class="item-capacity item-prop">{{item.system.weapon.magazine}}</div>
      <div class="item-rateoffire item-prop">{{item.system.weapon.rateOfFire}}</div>
      <div class="item-hands item-prop">{{localize (lookup @root.config.weaponHandedness item.system.weapon.handedness)}}</div>
      <div class="item-formula item-prop rollable" data-roll-type="item">{{item.system.formulaLabel}}</div>
      <div class="item-controls">
        <a
          class="item-control item-delete"
          title="{{localize "DOCUMENT.Delete" type='Item'}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    {{/if}}
  {{/each}}

</ol>
<h4>Armor</h4>
<ol class="items-list">
  <li class="item flexrow items-header">
    <div class="item-name">{{localize "Name"}}</div>
    <div class="item-rating">Rating</div>
    <div class="item-evasion">Evasion Penalty</div>
    <div class="item-location">Location</div>
    <div class="item-worn">Worn</div>
    <div class="item-controls">
    </div>
  </li>
  {{#each items as |item id|}}
    {{#if (eq item.type 'armor')}}
    <li class="item flexrow" data-item-id="{{item._id}}">
      <div class="item-name">
        <div class="item-image">
          <img
            src="{{item.img}}"
            title="{{item.name}}"
            width="24"
            height="24"
          />
        </div>
        <label>{{item.name}}</label>
      </div>
      <div class="item-rating item-prop">{{item.system.armor.rating}}</div>
      <div class="item-evasion item-prop">{{item.system.armor.evasionPenalty}}</div>
      <div class="item-location item-prop">{{localize (lookup @root.config.armorLocations item.system.armor.location)}}</div>
      <div class="item-worn item-prop">
        <input type="checkbox" class="armor-worn" data-item-id="{{item._id}}" {{#if item.system.armor.worn}}checked{{/if}} />
      </div>
      <div class="item-controls">
        <a
          class="item-control item-delete"
          title="{{localize "DOCUMENT.Delete" type='Item'}}"
        >
          <i class="fas fa-trash"></i>
        </a>
      </div>
    </li>
    {{/if}}
  {{/each}}
</ol>
<div class="item flexrow armor-totals-row">
  <div class="item-name resource-label">TOTAL</div>
  <div class="item-rating-arm item-prop">A {{system.armorTotals.rating.arm}}</div>
  <div class="item-rating-leg item-prop">L {{system.armorTotals.rating.leg}}</div>
  <div class="item-rating-torso item-prop">T {{system.armorTotals.rating.torso}}</div>
  <div class="item-rating-head item-prop">H {{system.armorTotals.rating.head}}</div>
  <div class="item-evasion item-prop">EP {{system.armorTotals.evasionPenalty}}</div>
  <div class="item-location item-prop">
    <div class="fa fa-minus-square decrease-armor-usage"></div>
    <a class="rollable" data-roll="{{system.armorUsage.currentDie}}" data-label="Armor Usage">{{system.armorUsage.currentDie}}</a>
    <a class="armor-repair" title="Repair Armor">
      <i class="fas fa-wrench"></i>
    </a>
  </div>
  <div class="item-worn"></div>
  <div class="item-controls"></div>
</div>
<h4>Gear</h4>
<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-controls'>
    </div>
  </li>
