<div class='{{cssClass}}'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-action="editImage" data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-1col'>
        <div class='resource'>
          <label class='resource-label'>Resource Cost</label>
          <select name='system.resourceCost.die'>
            {{#each config.resourceCostDice as |die|}}
              <option value='{{die}}' {{#if (eq ../system.resourceCost.die die)}}selected{{/if}}>{{die}}</option>
            {{/each}}
          </select>
          <label class='resource-label'>Resource Cost Multiplier</label>
          <select name='system.resourceCost.multiplier' data-dtype='Number'>
            {{#each config.resourceCostMultipliers as |mult|}}
              <option value='{{mult}}' {{#if (eq ../system.resourceCost.multiplier mult)}}selected{{/if}}>x{{mult}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='resource'>
        <div class='grid grid-2col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Threshold Base</label>
            <input
              type='text'
              name='system.drone.thresholdBase'
              value='{{system.drone.thresholdBase}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Threshold (+6/+8/+10)</label>
            <span>{{system.drone.thresholdBase}}/{{system.drone.thresholdStep1}}/{{system.drone.thresholdStep2}}/{{system.drone.thresholdStep3}}</span>
          </div>
        </div>
        <div class='grid grid-4col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Armor</label>
            <input
              type='text'
              name='system.drone.armor'
              value='{{system.drone.armor}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Evasion</label>
            <input
              type='text'
              name='system.drone.evasion'
              value='{{system.drone.evasion}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Handling</label>
            <input
              type='text'
              name='system.drone.handling'
              value='{{system.drone.handling}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Mounts</label>
            <input
              type='text'
              name='system.drone.mounts'
              value='{{system.drone.mounts}}'
              data-dtype='Number'
            />
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
