<div class='{{cssClass}}'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-action="editImage" data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-1col'>
        <div class='resource'>
          <label class='resource-label'>Size</label>
          <select name='system.size'>
            {{#each config.itemSizes as |label key|}}
              <option value='{{key}}' {{#if (eq ../system.size key)}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class='grid grid-1col'>
        <div class='resource'>
          <label class='resource-label'>Resource Cost</label>
          <select name='system.resourceCost.die'>
            {{#each config.resourceCostDice as |die|}}
              <option value='{{die}}' {{#if (eq ../system.resourceCost.die die)}}selected{{/if}}>{{die}}</option>
            {{/each}}
          </select>
          <label class='resource-label'>Resource Cost Multiplier</label>
          <select name='system.resourceCost.multiplier' data-dtype='Number'>
            {{#each config.resourceCostMultipliers as |mult|}}
              <option value='{{mult}}' {{#if (eq ../system.resourceCost.multiplier mult)}}selected{{/if}}>x{{mult}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='resource'>
        <div class='grid grid-3col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Range</label>
            <select name='system.cyberdeck.range'>
              {{#each config.cyberdeckRanges as |label key|}}
                <option value='{{key}}' {{#if (eq ../system.cyberdeck.range key)}}selected{{/if}}>{{localize label}}</option>
              {{/each}}
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Evasion</label>
            <input
              type='text'
              name='system.cyberdeck.evasion'
              value='{{system.cyberdeck.evasion}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Armor</label>
            <input
              type='text'
              name='system.cyberdeck.armor'
              value='{{system.cyberdeck.armor}}'
              data-dtype='Number'
            />
          </div>
        </div>
        <div class='grid grid-3col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Damage</label>
            <select name='system.cyberdeck.damageDie'>
              {{#each config.dice as |die|}}
                <option value='{{die}}' {{#if (eq ../system.cyberdeck.damageDie die)}}selected{{/if}}>{{die}}</option>
              {{/each}}
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Memory</label>
            <input
              type='text'
              name='system.cyberdeck.memory'
              value='{{system.cyberdeck.memory}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Modules</label>
            <input
              type='text'
              name='system.cyberdeck.modules'
              value='{{system.cyberdeck.modules}}'
              data-dtype='Number'
            />
          </div>
        </div>
        <div class='grid grid-2col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Threshold Base</label>
            <input
              type='text'
              name='system.cyberdeck.thresholdBase'
              value='{{system.cyberdeck.thresholdBase}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Threshold (+6/+8/+10)</label>
            <span>{{system.cyberdeck.thresholdBase}}/{{system.cyberdeck.thresholdStep1}}/{{system.cyberdeck.thresholdStep2}}/{{system.cyberdeck.thresholdStep3}}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
