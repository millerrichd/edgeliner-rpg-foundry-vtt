<div class='{{cssClass}}'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-action="editImage" data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-1col'>
        <div class='resource'>
          <label class='resource-label'>Resource Cost</label>
          <select name='system.resourceCost.die'>
            {{#each config.resourceCostDice as |die|}}
              <option value='{{die}}' {{#if (eq ../system.resourceCost.die die)}}selected{{/if}}>{{die}}</option>
            {{/each}}
          </select>
          <label class='resource-label'>Resource Cost Multiplier</label>
          <select name='system.resourceCost.multiplier' data-dtype='Number'>
            {{#each config.resourceCostMultipliers as |mult|}}
              <option value='{{mult}}' {{#if (eq ../system.resourceCost.multiplier mult)}}selected{{/if}}>x{{mult}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> "systems/edgeliner-rpg/templates/item/parts/item-effects.hbs"}}
    </div>
  </section>
</div>
