<div class='{{cssClass}}'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-action="editImage" data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
        <div class='resource'>
          <label class='resource-label'>Size</label>
          <select name='system.size'>
            {{#each config.itemSizes as |label key|}}
              <option value='{{key}}' {{#if (eq ../system.size key)}}selected{{/if}}>{{localize label}}</option>
            {{/each}}
          </select>
        </div>
        <div class='resource'>
          <label class='resource-label'>Resource Cost</label>
          <select name='system.resourceCost.die'>
            {{#each config.resourceCostDice as |die|}}
              <option value='{{die}}' {{#if (eq ../system.resourceCost.die die)}}selected{{/if}}>{{die}}</option>
            {{/each}}
          </select>
          <label class='resource-label'>Resource Cost Multiplier</label>
          <select name='system.resourceCost.multiplier' data-dtype='Number'>
            {{#each config.resourceCostMultipliers as |mult|}}
              <option value='{{mult}}' {{#if (eq ../system.resourceCost.multiplier mult)}}selected{{/if}}>x{{mult}}</option>
            {{/each}}
          </select>
        </div>
      </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      <div class='resource'>
        <label class='resource-label'>Damage:</label>
        <span>{{system.formulaLabel}}</span>
        <div class='grid grid-3col'>
          <div class='grid-span-1'>
            <label class='resource-label'>First Die</label>
            <select name='system.weapon.firstDie'>
              {{#each config.dice as |die|}}
                <option value='{{die}}' {{#if (eq ../system.weapon.firstDie die)}}selected{{/if}}>{{die}}</option>
              {{/each}}
              <option value='might' {{#if (eq system.weapon.firstDie "might")}}selected{{/if}}>Might</option>
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Second Die</label>
            <select name='system.weapon.die'>
              {{#each config.dice as |die|}}
                <option value='{{die}}' {{#if (eq ../system.weapon.die die)}}selected{{/if}}>{{die}}</option>
              {{/each}}
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Bonus</label>
            <input
              type='text'
              name='system.weapon.bonus'
              value='{{system.weapon.bonus}}'
              data-dtype='Number'
            />
          </div>
        </div>
        <div class='grid grid-4col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Stamina</label>
            <input
              type='text'
              name='system.weapon.stamina'
              value='{{system.weapon.stamina}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Damage Type</label>
            <select name='system.weapon.damageType'>
              {{#each config.weaponDamageTypes as |label key|}}
                <option value='{{key}}' {{#if (eq ../system.weapon.damageType key)}}selected{{/if}}>{{localize label}}</option>
              {{/each}}
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Magazine</label>
            <input
              type='text'
              name='system.weapon.magazine'
              value='{{system.weapon.magazine}}'
              data-dtype='Number'
            />
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Rate of Fire</label>
            <input
              type='text'
              name='system.weapon.rateOfFire'
              value='{{system.weapon.rateOfFire}}'
              data-dtype='Number'
            />
          </div>
        </div>
        <div class='grid grid-2col'>
          <div class='grid-span-1'>
            <label class='resource-label'>Range</label>
            <select name='system.weapon.range'>
              {{#each config.weaponRanges as |label key|}}
                <option value='{{key}}' {{#if (eq ../system.weapon.range key)}}selected{{/if}}>{{localize label}}</option>
              {{/each}}
            </select>
          </div>
          <div class='grid-span-1'>
            <label class='resource-label'>Hands</label>
            <select name='system.weapon.handedness'>
              {{#each config.weaponHandedness as |label key|}}
                <option value='{{key}}' {{#if (eq ../system.weapon.handedness key)}}selected{{/if}}>{{localize label}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>